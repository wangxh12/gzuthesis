% \subsection{主文档结构}
% \label{sec:mainmatter}
%
% GZUThesis 参考 ThuThesis，采用 |frontmatter|、
% |mainmatter| 和 |backmatter| 三个命令划分论文结构。
%
% \subsubsection{双面分页处理}
%
% 对于双面排版，章节通常从奇数页开始。
% 当需要插入空白页时，不显示页眉、页脚和页码。
%
%    \begin{macrocode}
% 双面分页处理
% print      : 必要时补充空白页，保证右页起始
% electronic : 只结束当前页，不额外补充空白页
\renewcommand\cleardoublepage{%
  \clearpage
  \if@twoside
    \ifgzu@output@print
      \ifodd\c@page
      \else
        \thispagestyle{empty}%
        \hbox{}%
        \newpage
        \if@twocolumn
          \hbox{}\newpage
        \fi
      \fi
    \fi
  \fi
}
%    \end{macrocode}
%
% \subsubsection{前置部分}
%
% 前置部分不对章节编号，页码采用大写罗马数字。
% 进入前置部分时，页码从 I 开始。
%
%    \begin{macrocode}
\renewcommand\frontmatter{%
  \cleardoublepage
  \@mainmatterfalse
  \pagenumbering{Roman}%
}
%    \end{macrocode}
%
% \subsubsection{正文部分}
%
% 正文部分启用章节编号，页码采用阿拉伯数字。
% 进入正文部分时，页码从 1 开始。
%
%    \begin{macrocode}
\renewcommand\mainmatter{%
  \cleardoublepage
  \@mainmattertrue
  \pagenumbering{arabic}%
}
%    \end{macrocode}
%
% \subsubsection{后置部分}
%
% 后置部分不对章节编号，页码延续正文部分。
% 具体目录深度将在目录模块中设置。
%
%    \begin{macrocode}
\renewcommand\backmatter{%
  \clearpage
  \@mainmatterfalse
}
%    \end{macrocode}
% 
% 

% \subsubsection{未编号章节的统一处理}
%
% 用于摘要、致谢、符号对照表、参考文献等。
% 在生成章节标题之前建立 PDF 跳转锚点，
% 保证目录链接和书签跳转到章节顶部。
%
% 第一个参数：页面显示的标题
% 第二个参数：目录与页眉使用的标题
%
%    \begin{macrocode}
\newcommand\gzu@unnumbered@chapter[2]{%
  % 先切换到目标章节所在页面
  \if@openright
    \cleardoublepage
  \else
    \clearpage
  \fi
  % 在章节标题之前建立跳转锚点
  \@ifpackageloaded{hyperref}{\phantomsection}{}%
  % 记录目录和 PDF 书签
  \addcontentsline{toc}{chapter}{#2}%
  % 生成未编号章节标题
  \chapter*{#1}%
  % 设置页眉
  \markboth{#2}{#2}%
}
%    \end{macrocode}
% 
% 
% 
% \subsection{目录}
% \label{sec:toc}
%
% GZUThesis 参考 ThuThesis 的研究生论文目录格式，
% 使用 |titletoc| 宏包控制目录条目的字体、缩进、
% 引导点及页码格式。
%
% \subsubsection{目录基本设置}
%
% 目录显示到 |subsection| 层级，
% 即章、节、小节三级。
%
%    \begin{macrocode}
\RequirePackage{titletoc}

\setcounter{tocdepth}{2}
\renewcommand\contentsname{目\quad 录}
%    \end{macrocode}
%
% \subsubsection{目录生成命令}
%
% 重新定义 \cs{tableofcontents}，
% 使用不编号的章标题生成目录首页。
% 目录自身不加入目录。
%
%    \begin{macrocode}
\renewcommand\tableofcontents{%
  \chapter*{\contentsname}%
