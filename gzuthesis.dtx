% \subsection{数学公式}
% \label{sec:math}
%
% GZUThesis 参考 ThuThesis 的数学排版方案，
% 使用 |amsmath| 提供公式环境，
% 使用 |unicode-math| 配置数学字体和符号样式。
%
% \subsubsection{数学字体与符号样式}
%
% 参考 ThuThesis，将数学字体与数学样式分开配置。
% 数学字体支持 lm、stix、xits 和 libertinus。
% 数学样式支持 GB、ISO 和 TeX，默认 ISO。
%
%    \begin{macrocode}
\RequirePackage{amsmath}
\RequirePackage{unicode-math}

% 数学风格的基本正斜体配置
\newcommand\gzu@apply@math@style{%
  \ifgzu@math@style@TeX
    \unimathsetup{
      math-style = TeX,
      bold-style = TeX,
      partial    = italic,
    }%
  \else
    \unimathsetup{
      math-style = ISO,
      bold-style = ISO,
      partial    = upright,
    }%
  \fi
}

% 补充不同数学风格下的符号规则
% 在文档开始时应用，确保 unicode-math 符号已经定义
\newcommand\gzu@apply@math@symbols{%
  \ifgzu@math@style@GB
    \let\le\leqslant
    \let\ge\geqslant
    \let\leq\leqslant
    \let\geq\geqslant
    \addnolimits{\int\iint\iiint\oint}%
    \def\mathellipsis{\mathinner{\unicodecdots}}%
  \else
    \let\le\leq
    \let\ge\geq
    \ifgzu@math@style@ISO
      \removenolimits{\int\iint\iiint\oint}%
    \else
      \addnolimits{\int\iint\iiint\oint}%
    \fi
    \def\mathellipsis{\mathinner{\unicodeellipsis}}%
  \fi
  \ifgzu@math@style@TeX\else
    \def\Re{\operatorname{Re}}%
    \def\Im{\operatorname{Im}}%
  \fi
}

\AddToHook{begindocument/end}{%
  \gzu@apply@math@symbols
}


% 根据配置选择数学字体
% 先完成条件判断，再统一执行字体加载
\newcommand\gzu@apply@math@font{%
  \ifgzu@math@font@lm
    \def\gzu@math@load{%
      \setmathfont{latinmodern-math.otf}%
    }%
  \else\ifgzu@math@font@stix
    \ifgzu@math@style@TeX
      \def\gzu@math@load{%
        \setmathfont{STIXTwoMath-Regular.otf}%
      }%
    \else
      \def\gzu@math@load{%
        \setmathfont[
          StylisticSet = 8
        ]{STIXTwoMath-Regular.otf}%
      }%
    \fi
  \else\ifgzu@math@font@xits
    \ifgzu@math@style@TeX
      \def\gzu@math@load{%
        \setmathfont[
          BoldFont = XITSMath-Bold.otf
        ]{XITSMath-Regular.otf}%
      }%
    \else
      \def\gzu@math@load{%
        \setmathfont[
          BoldFont = XITSMath-Bold.otf,
          StylisticSet = 8
        ]{XITSMath-Regular.otf}%
      }%
    \fi
  \else\ifgzu@math@font@libertinus
    \ifgzu@math@style@TeX
      \def\gzu@math@load{%
        \setmathfont[
          StylisticSet = 8
        ]{LibertinusMath-Regular.otf}%
      }%
    \else
      \def\gzu@math@load{%
        \setmathfont{LibertinusMath-Regular.otf}%
      }%
    \fi
  \fi\fi\fi\fi

  % 在全部条件结束后加载数学字体
  \gzu@math@load
  % STIX 模式下采用传统衬线黑板粗体
  \ifgzu@math@font@stix
    \setmathfont{latinmodern-math.otf}[range=bb]%
  \fi
}


% 统一应用数学配置
\newcommand\gzu@apply@math@settings{%
  \gzu@apply@math@style
  \gzu@apply@math@font
}

% 导言区结束后统一应用数学字体及样式
% 避免在 \gzusetup 解析过程中反复加载数学字体
\AddToHook{begindocument/before}{%
  \gzu@apply@math@settings
  \gzu@option@classonly{math-style}%
  \gzu@option@classonly{math-font}%
}

