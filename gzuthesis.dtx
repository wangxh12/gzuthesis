% \subsection{主文档结构}
% \label{sec:mainmatter}
%
% GZUThesis 参考 ThuThesis，采用 |frontmatter|、
% |mainmatter| 和 |backmatter| 三个命令划分论文结构。
%
% \subsubsection{双面分页处理}
%
% 对于双面排版，章节通常从奇数页开始。
% 当需要插入空白页时，不显示页眉、页脚和页码。
%
%    \begin{macrocode}
\renewcommand\cleardoublepage{%
  \clearpage
  \if@twoside
    \ifodd\c@page
    \else
      \thispagestyle{empty}%
      \hbox{}%
      \newpage
      \if@twocolumn
        \hbox{}\newpage
      \fi
    \fi
  \fi
}
%    \end{macrocode}
%
% \subsubsection{前置部分}
%
% 前置部分不对章节编号，页码采用大写罗马数字。
% 进入前置部分时，页码从 I 开始。
%
%    \begin{macrocode}
\renewcommand\frontmatter{%
  \cleardoublepage
  \@mainmatterfalse
  \pagenumbering{Roman}%
}
%    \end{macrocode}
%
% \subsubsection{正文部分}
%
% 正文部分启用章节编号，页码采用阿拉伯数字。
% 进入正文部分时，页码从 1 开始。
%
%    \begin{macrocode}
\renewcommand\mainmatter{%
  \cleardoublepage
  \@mainmattertrue
  \pagenumbering{arabic}%
}
%    \end{macrocode}
%
% \subsubsection{后置部分}
%
% 后置部分不对章节编号，页码延续正文部分。
% 具体目录深度将在目录模块中设置。
%
%    \begin{macrocode}
\renewcommand\backmatter{%
  \clearpage
  \@mainmatterfalse
}
%    \end{macrocode}
% 
% \subsection{目录}
% \label{sec:toc}
%
% GZUThesis 参考 ThuThesis 的研究生论文目录格式，
% 使用 |titletoc| 宏包控制目录条目的字体、缩进、
% 引导点及页码格式。
%
% \subsubsection{目录基本设置}
%
% 目录显示到 |subsection| 层级，
% 即章、节、小节三级。
%
%    \begin{macrocode}
\RequirePackage{titletoc}

\setcounter{tocdepth}{2}
\renewcommand\contentsname{目\quad 录}
%    \end{macrocode}
%
% \subsubsection{目录生成命令}
%
% 重新定义 \cs{tableofcontents}，
% 使用不编号的章标题生成目录首页。
% 目录自身不加入目录。
%
%    \begin{macrocode}
\renewcommand\tableofcontents{%
  \chapter*{\contentsname}%
  \markboth{\contentsname}{\contentsname}%
  \begingroup
    \setlength{\parskip}{0pt}%
    \@starttoc{toc}%
  \endgroup
}
%    \end{macrocode}
%
% \subsubsection{目录引导线}
%
% 目录条目与页码之间使用点线连接。
%
%    \begin{macrocode}
\contentsmargin{0pt}

\newcommand\gzu@toc@leaders{%
  \nobreak\titlerule*[4bp]{.}\nobreak
}
%    \end{macrocode}
%
% \subsubsection{目录条目格式}
%
% 章目录条目采用黑体小四号字，左对齐，
% 固定行距 20 bp，段前段后均为 0。
% 章编号与标题之间使用 \cs{quad} 分隔。
%
%    \begin{macrocode}
\titlecontents{chapter}
  [0pt]
  {\sffamily\fontsize{12bp}{20bp}\selectfont}
  {\contentspush{\thecontentslabel\quad}}
  {}
  {\rmfamily\gzu@toc@leaders\thecontentspage}
%    \end{macrocode}
%
% 节目录条目采用宋体小四号字，
% 左侧缩进一个汉字符。
%
%    \begin{macrocode}
\titlecontents{section}
  [1em]
  {\rmfamily\fontsize{12bp}{20bp}\selectfont}
  {\contentspush{\thecontentslabel\quad}}
  {}
  {\gzu@toc@leaders\thecontentspage}
%    \end{macrocode}
%
% 小节目录条目采用宋体小四号字，
% 左侧缩进两个汉字符。
%
%    \begin{macrocode}
\titlecontents{subsection}
  [2em]
  {\rmfamily\fontsize{12bp}{20bp}\selectfont}
  {\contentspush{\thecontentslabel\quad}}
  {}
  {\gzu@toc@leaders\thecontentspage}
%    \end{macrocode}
%
% 

% \subsection{插图和表格}
% \label{sec:float}
%
% GZUThesis 参考 ThuThesis 的研究生论文格式，
% 设置图表编号、题注、表格字体及浮动体参数。
%
% \subsubsection{加载宏包}
%
% 使用 |graphicx| 支持图片插入，
% 使用 |subcaption| 设置子图，
% 使用 |booktabs| 排版三线表。
%
%    \begin{macrocode}
\RequirePackage{graphicx}
\RequirePackage[labelformat=simple]{subcaption}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{etoolbox}
\RequirePackage{bicaption}
%    \end{macrocode}
%
% \subsubsection{图表名称}
%
% 定义中文图表标签及清单名称。
%
%    \begin{macrocode}
\renewcommand\figurename{图}
\renewcommand\tablename{表}
\renewcommand\listfigurename{插图清单}
\renewcommand\listtablename{附表清单}
%    \end{macrocode}
%
% \subsubsection{图表编号}
%
% 默认按照章节编号，连接符为句点。
% 例如，第一章第一幅图编号为 1.1。
%
%    \begin{macrocode}
\newcommand\gzu@figure@separator{.}
\newcommand\gzu@table@separator{.}

\renewcommand\thefigure{%
  \ifnum\c@chapter>\z@
    \thechapter\gzu@figure@separator
  \fi
  \arabic{figure}%
}

\renewcommand\thetable{%
  \ifnum\c@chapter>\z@
    \thechapter\gzu@table@separator
  \fi
  \arabic{table}%
}
%    \end{macrocode}
%
% 提供图表编号连接符的配置接口。
%
%    \begin{macrocode}
\kv@define@key{gzuinfo}{figure-number-separator}{%
  \def\gzu@figure@separator{#1}%
}

\kv@define@key{gzuinfo}{table-number-separator}{%
  \def\gzu@table@separator{#1}%
}
%    \end{macrocode}
%
% \subsubsection{图表题注}
%
% 本轮保留原有 11 bp 字号、14.3 bp 基线间距和 6 bp 图文间距。
% 题注居中，编号与题目之间空一个字距。
% 图题写在图的下方，表题写在表的上方。
%
%    \begin{macrocode}
\DeclareCaptionFont{gzu}{%
  \fontsize{11bp}{14.3bp}\selectfont
}

\captionsetup{
  font           = {gzu,rm},
  labelsep       = quad,
  justification  = centering,
  singlelinecheck = false,
  skip           = 6bp,
  figureposition = bottom,
  tableposition  = top,
}
%    \end{macrocode}
%
% 双语题注使用同一个图表编号，中文在上、英文在下。
% 仅中文题注写入现有图表清单，英文不重复写入。
% 当前为中文论文，不引入额外的正文语言切换。
%
%    \begin{macrocode}
\captionsetup{bi-swap=false}
\bicaptionsetup
  {font={gzu,rm}}
  {font={gzu,rm},list=off}
\bicaptionsetup[figure]{name=图}{name=Figure}
\bicaptionsetup[table]{name=表}{name=Table}
%    \end{macrocode}
%
% 题注语言可通过 |caption-language| 统一配置：
% |auto| 按学位类型选择，硕士中文、博士双语；
% |chinese| 只显示中文；|bilingual| 显示中英文。
% 此配置控制本模板接口及原生双语题注，不覆盖普通 \cs{caption}。
%
%    \begin{macrocode}
\newif\ifgzu@caption@bilingual
\newcommand\gzu@caption@language{auto}

\newcommand\gzu@set@caption@language[1]{%
  \ifboolexpr{
    test {\ifstrequal{#1}{auto}} or
    test {\ifstrequal{#1}{chinese}} or
    test {\ifstrequal{#1}{bilingual}}
  }{%
    \def\gzu@caption@language{#1}%
    \ifstrequal{#1}{auto}{%
      \ifgzu@degree@doctor
        \gzu@caption@bilingualtrue
      \else
        \gzu@caption@bilingualfalse
      \fi
    }{%
      \ifstrequal{#1}{bilingual}
        {\gzu@caption@bilingualtrue}
        {\gzu@caption@bilingualfalse}%
    }%
    \ifgzu@caption@bilingual
      \captionsetup{bi-lang=both}%
    \else
      \captionsetup{bi-lang=first}%
      \ifgzu@degree@doctor
        \ClassWarningNoLine{gzuthesis}{%
          Chinese-only captions selected for a doctoral thesis.
          Use auto or bilingual for bilingual captions}%
      \fi
    \fi
  }{%
    \ClassError{gzuthesis}{Invalid caption-language `#1'}%
      {Use auto, chinese, or bilingual.}%
  }%
}

\kv@define@key{gzuinfo}{caption-language}{%
  \gzu@set@caption@language{#1}%
}
\gzu@set@caption@language{auto}
%    \end{macrocode}
%
% 统一题注接口：可选参数用于中文清单短标题，
% 两个必选参数依次为中文和英文题目。
% 双语模式缺少英文时报错，中文模式忽略英文参数。
% 不覆盖原生 \cs{caption}，保留宏包兼容性。
%
%    \begin{macrocode}
\NewDocumentCommand\gzucaption{o m m}{%
  \ifgzu@caption@bilingual
    \ifblank{#3}{%
      \ClassError{gzuthesis}
        {An English caption is required in bilingual mode}%
        {Fill the second mandatory argument of
         \string\gzucaption.}%
    }{}%
    \IfNoValueTF{#1}
      {\bicaption{#2}{#3}}
      {\bicaption[#1]{#2}{#3}}%
  \else
    \IfNoValueTF{#1}
      {\caption{#2}}
      {\caption[#1]{#2}}%
  \fi
}
%    \end{macrocode}
