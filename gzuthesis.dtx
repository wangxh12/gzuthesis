%
% 参考 ThuThesis，使用 enumitem 实现符号对照表。
% denotation 环境自动生成标题，并支持设置符号列宽。
% 默认符号列宽为 2.5 cm，可通过可选参数调整。
%
% \subsubsection{加载宏包}
%
%    \begin{macrocode}
\RequirePackage{enumitem}
%    \end{macrocode}
%
% \subsubsection{符号对照表名称}
%
%    \begin{macrocode}
\newcommand\gzu@denotation@name{主要符号对照表}
%    \end{macrocode}
%
% \subsubsection{符号列表样式}
%
% 使用 description 列表实现双列结构。
% 左侧为符号或缩略语，右侧为其对应说明。
%
%    \begin{macrocode}
\newlist{gzu@denotation}{description}{1}

\setlist[gzu@denotation]{%
  nosep,
  font=\normalfont,
  align=left,
  leftmargin=!,
  labelindent=0pt,
  labelwidth=2.5cm,
  labelsep*=0.5cm,
  itemindent=0pt,
}
%    \end{macrocode}
%
% \subsubsection{符号对照表环境}
%
% 自动生成不编号章节标题，并加入目录。
% 可选参数用于设置左侧符号列宽度。
%
%    \begin{macrocode}
\newenvironment{denotation}[1][2.5cm]{%
  \gzu@unnumbered@chapter
    {\gzu@denotation@name}
    {\gzu@denotation@name}%
  \begin{gzu@denotation}[labelwidth=#1]%
}{%
  \end{gzu@denotation}%
}
%    \end{macrocode}
