% section 层级的参考文献标题
\newcommand\gzu@bib@section@heading[1]{%
  \clearpage
  \@ifpackageloaded{hyperref}{\phantomsection}{}%
  \addcontentsline{toc}{section}{#1}%
  \begingroup
    \ctexset{section/format={\gzu@bib@title@format}}%
    \section*{#1}%
  \endgroup
  \markboth{#1}{#1}%
}

% chapter 层级的参考文献标题
\newcommand\gzu@bib@chapter@heading[1]{%
  \begingroup
