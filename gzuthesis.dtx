    \fi
  }%
%    \end{macrocode}
%
% 页脚居中显示页码，采用五号西文字体。
%
%    \begin{macrocode}
  \fancyfoot[C]{%
    \rmfamily
    \fontsize{10.5bp}{12.1bp}\selectfont
    \thepage
  }%
%    \end{macrocode}
%
% \subsubsection{章节标记}
%
% 重新定义章节标记，仅在页眉显示当前章的信息，
% 不显示节标题。
%
%    \begin{macrocode}
  \let\@mkboth\markboth
  \def\chaptermark##1{%
    \markboth{%
      \CTEXifname{\CTEXthechapter\quad}{}##1%
    }{}%
  }%
  \let\sectionmark\@gobble
}
