% 左上角标签统一宽度
\newlength\gzu@cover@left@labelwidth
\newlength\gzu@cover@left@tmpwidth

\newcommand\gzu@cover@measure@left{%
  % 测量中文标签
  \settowidth\gzu@cover@left@labelwidth{%
    {\gzu@cover@song\gzu@cover@times
     \fontsize{12bp}{16bp}\selectfont
     中图分类号}%
  }%

  % 测量 UDC 标签
