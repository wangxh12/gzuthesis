%
% \subsubsection{中文字体}
%
% 支持 Windows、macOS、思源和 Fandol 字体库。
% 默认通过 |fontset=auto| 自动选择。
%
%    \begin{macrocode}

\ifgzu@fontset@auto
  \IfFontExistsTF{SimSun}{
    \gzu@set@key{fontset}{windows}
  }{
    \IfFontExistsTF{Songti SC}{
      \gzu@set@key{fontset}{mac}
    }{
