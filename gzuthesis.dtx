%
% \subsection{附录}
% \label{sec:appendix}
%
% 使用标准 \cs{appendix} 命令开启附录，
% 附录按照 A、B、C 等大写英文字母编号。
%
% 即使已经执行 \cs{backmatter}，
% 附录仍然需要启用章节编号。
%
% 附录编号和标题分别占一行，居中排版。
% 目录默认只列出附录章标题。
%
%    \begin{macrocode}
\g@addto@macro\appendix{%
  \@mainmattertrue
  \ctexset{
    chapter = {
      name = {附录~,},
      aftername = \par,
    }
  }%
  \protected@write\@auxout{}{%
    \string\ttl@writefile{toc}{%
      \protect\setcounter{tocdepth}{0}%
    }%
  }%
}
%    \end{macrocode}
