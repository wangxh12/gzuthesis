}
\renewcommand\thetable{%
  \ifgzu@table@numbering@chapter
    \ifnum\c@chapter>\z@
      \thechapter\gzu@table@separator
    \fi
  \fi
  \arabic{table}%
}
%    \end{macrocode}
%
% 提供图表编号连接符的配置接口。
%
%    \begin{macrocode}
% 配置项已在统一配置系统中声明。

% 配置项已在统一配置系统中声明。
%    \end{macrocode}
%
% \subsubsection{图表题注}
%
% 本轮保留原有 11 bp 字号、14.3 bp 基线间距和 6 bp 图文间距。
% 题注居中，编号与题目之间空一个字距。
% 图题写在图的下方，表题写在表的上方。
%
%    \begin{macrocode}
\DeclareCaptionFont{gzu}{%
  \fontsize{11bp}{14.3bp}\selectfont
}

\captionsetup{
  font           = {gzu,rm},
  labelsep       = quad,
  justification  = centering,
  singlelinecheck = false,
  skip           = 6bp,
  figureposition = bottom,
  tableposition  = top,
}
%    \end{macrocode}
%
% 双语题注使用同一个图表编号，中文在上、英文在下。
% 仅中文题注写入现有图表清单，英文不重复写入。
% 当前为中文论文，不引入额外的正文语言切换。
%
%    \begin{macrocode}
\captionsetup{bi-swap=false}
\bicaptionsetup
  {font={gzu,rm}}
  {font={gzu,rm},list=off}
\bicaptionsetup[figure]{name=图}{name=Figure}
\bicaptionsetup[table]{name=表}{name=Table}
%    \end{macrocode}
%
% 题注语言可通过 |caption-language| 统一配置：
% |auto| 按学位类型选择，硕士中文、博士双语；
% |chinese| 只显示中文；|bilingual| 显示中英文。
% 此配置控制本模板接口及原生双语题注，不覆盖普通 \cs{caption}。
%
%    \begin{macrocode}
\newif\ifgzu@caption@bilingual

\newcommand\gzu@apply@caption@language{%
  \ifgzu@caption@language@auto
    \ifgzu@degree@doctor
      \gzu@caption@bilingualtrue
    \else
      \gzu@caption@bilingualfalse
    \fi
  \else
    \ifgzu@caption@language@bilingual
      \gzu@caption@bilingualtrue
    \else
      \gzu@caption@bilingualfalse
    \fi
  \fi
  \ifgzu@caption@bilingual
    \captionsetup{bi-lang=both}%
  \else
    \captionsetup{bi-lang=first}%
    \ifgzu@degree@doctor
      \ClassWarningNoLine{gzuthesis}{%
        Chinese-only captions selected for a doctoral thesis.
        Use auto or bilingual for bilingual captions}%
    \fi
  \fi
}
\gzu@apply@caption@language
\gzu@option@hook{caption-language}{\gzu@apply@caption@language}
%    \end{macrocode}
%
% 统一题注接口：可选参数用于中文清单短标题，
% 两个必选参数依次为中文和英文题目。
% 双语模式缺少英文时报错，中文模式忽略英文参数。
% 不覆盖原生 \cs{caption}，保留宏包兼容性。
%
%    \begin{macrocode}
\NewDocumentCommand\gzucaption{o m m}{%
  \ifgzu@caption@bilingual
    \ifblank{#3}{%
      \ClassError{gzuthesis}
        {An English caption is required in bilingual mode}%
        {Fill the second mandatory argument of
         \string\gzucaption.}%
    }{}%
    \IfNoValueTF{#1}
      {\bicaption{#2}{#3}}
      {\bicaption[#1]{#2}{#3}}%
  \else
    \IfNoValueTF{#1}
      {\caption{#2}}
      {\caption[#1]{#2}}%
  \fi
}
%    \end{macrocode}
%
% 子图保留 (a)、(b) 等编号；可通过 \cs{bisubcaption}
% 使用双语子图题注。子图不重复出现 Figure/Table 名称。
%
%    \begin{macrocode}
\captionsetup[sub]{font={gzu,rm}}
\renewcommand\thesubfigure{(\alph{subfigure})}
\renewcommand\thesubtable{(\alph{subtable})}
%    \end{macrocode}
