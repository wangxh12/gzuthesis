% \subsection{正文段落}
% \label{sec:paragraph}
%
% 参考 ThuThesis，中文正文段落首行缩进两个汉字符，
% 中文标点采用全角模式。
%
%    \begin{macrocode}
\ctexset{
  punct      = quanjiao,
  autoindent = 2,
}
%    \end{macrocode}
%
% \subsection{章节标题}
% \label{sec:section}
%
% 参考 ThuThesis 研究生学位论文的章节标题设置。
% 章标题居中，节及以下各级标题左对齐。
%
% \subsubsection{标题格式}
%
% 章标题采用黑体三号字，段前和段后均为 27 bp。
% 章序号采用阿拉伯数字，标题形式为“第 1 章 绪论”。
%
% 一级节标题采用黑体 14 bp，段前 24 bp，段后 6 bp。
% 二级节标题采用黑体 13 bp，段前 12 bp，段后 6 bp。
% 三级节标题采用黑体 12 bp，段前 12 bp，段后 6 bp。
%
%    \begin{macrocode}
\ctexset{
  chapter = {
    name         = {第,章},
    number       = \thechapter,
    format       = \centering\sffamily
                   \fontsize{16bp}{20.8bp}\selectfont,
    nameformat   = {},
    numberformat = {},
    titleformat  = {},
    aftername    = \quad,
    beforeskip   = 27bp,
    afterskip    = 27bp,
    fixskip      = true,
    afterindent  = true,
  },
  section = {
    format       = \sffamily
                   \fontsize{14bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 24bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
  subsection = {
    format       = \sffamily
                   \fontsize{13bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 12bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
  subsubsection = {
    format       = \sffamily
                   \fontsize{12bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 12bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
}
%    \end{macrocode}
%
% \subsubsection{标题编号深度}
%
% 正文标题编号到三级节标题，
% 即 |subsubsection| 层级。
%
%    \begin{macrocode}
\setcounter{secnumdepth}{3}
%    \end{macrocode}
% 
% 
% \subsection{页眉页脚}
% \label{sec:headerfooter}
%
% GZUThesis 参考 ThuThesis 的研究生学位论文样式，
% 使用 |fancyhdr| 宏包设置页眉和页脚。
%
% 页眉采用宋体五号字，居中显示当前章编号及标题，
% 下方设置 0.75 bp 的横线。
% 页脚采用五号西文字体，页码居中显示。
%
% \subsubsection{加载宏包}
%
% 首先激活 |fancy| 页面样式，
% 避免后续配置章节标记时被默认设置覆盖。
%
%    \begin{macrocode}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
%    \end{macrocode}
%
% \subsubsection{定义页面样式}
%
% 使用 |plain| 作为论文的基本页面样式。
%
%    \begin{macrocode}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand\headrulewidth{0.75bp}%
  \renewcommand\footrulewidth{0pt}%
%    \end{macrocode}
%
% 页眉居中显示当前章编号及标题，
% 采用宋体五号字。
%
%    \begin{macrocode}
% 奇数页：显示当前章编号及标题
  \fancyhead[CO]{%
    \songti
    \fontsize{10.5bp}{12.1bp}\selectfont
    \nouppercase{\leftmark}%
  }%
% 偶数页：根据学位类型显示论文名称
  \fancyhead[CE]{%
    \songti
    \fontsize{10.5bp}{12.1bp}\selectfont
    \ifgzu@degree@doctor
      贵州大学博士学位论文%
    \else
      贵州大学硕士学位论文%
    \fi
  }%
%    \end{macrocode}
%
% 页脚居中显示页码，采用五号西文字体。
%
%    \begin{macrocode}
  \fancyfoot[C]{%
    \rmfamily
    \fontsize{10.5bp}{12.1bp}\selectfont
    \thepage
  }%
%    \end{macrocode}
%
% \subsubsection{章节标记}
%
% 重新定义章节标记，仅在页眉显示当前章的信息，
% 不显示节标题。
%
%    \begin{macrocode}
  \let\@mkboth\markboth
  \def\chaptermark##1{%
    \markboth{%
      \CTEXifname{\CTEXthechapter\quad}{}##1%
    }{}%
  }%
  \let\sectionmark\@gobble
}
%    \end{macrocode}
%
% \subsubsection{应用页面样式}
%
% 将 |plain| 设置为默认页面样式，
% 并应用于章首页。
%
%    \begin{macrocode}
\pagestyle{plain}
\ctexset{
  chapter/pagestyle = plain,
}
%    \end{macrocode}
