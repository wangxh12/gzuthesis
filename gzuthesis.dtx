%
% \section{实现细节}
%
% 以下代码用于生成 |gzuthesis.cls|。
%
% \subsection{基本信息}
%
% 声明文档类的名称和版本。
%
%    \begin{macrocode}
%<*cls>
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{gzuthesis}[2026/11/15 v0.1.0 Guizhou University Thesis Template]
%    \end{macrocode}
%
% \subsection{文档类选项}
%
% GZUThesis 支持硕士和博士学位论文，
% 并区分学术学位和专业学位。
%
% \subsubsection{选项定义}
%
% 使用 |kvoptions| 宏包处理文档类选项。
%
%    \begin{macrocode}
\RequirePackage{kvoptions}

\SetupKeyvalOptions{
  family = gzu,
  prefix = gzu@,
}
%    \end{macrocode}
%
% 定义学位层次选项 |degree|，默认值为 |master|。
% 定义学位类别选项 |degree-type|，默认值为 |academic|。
%
%    \begin{macrocode}
\DeclareStringOption[master]{degree}
\DeclareStringOption[academic]{degree-type}
\DeclareStringOption[auto]{fontset}
\DeclareStringOption[xits]{math-font}
%    \end{macrocode}
%
% 未由 GZUThesis 处理的选项传递给 |ctexbook|。
%
%    \begin{macrocode}
\DeclareDefaultOption{
  \PassOptionsToClass{\CurrentOption}{ctexbook}
}

\ProcessKeyvalOptions*
%    \end{macrocode}
%
% \subsubsection{学位类型判断}
%
% 定义内部条件变量，供后续模块判断学位类型。
%
%    \begin{macrocode}
\newif\ifgzu@degree@master
\newif\ifgzu@degree@doctor

\newif\ifgzu@degree@type@academic
\newif\ifgzu@degree@type@professional
%    \end{macrocode}
%
% 定义用于比较的字符串常量。
%
%    \begin{macrocode}
\def\gzu@master{master}
\def\gzu@doctor{doctor}

\def\gzu@academic{academic}
\def\gzu@professional{professional}
%    \end{macrocode}
%
% 根据 |degree| 的取值设置对应条件。
% 当取值不合法时，给出错误信息。
%
%    \begin{macrocode}
\ifx\gzu@degree\gzu@master
  \gzu@degree@mastertrue
\else
  \ifx\gzu@degree\gzu@doctor
    \gzu@degree@doctortrue
  \else
    \ClassError{gzuthesis}
      {Invalid degree `\gzu@degree'}
      {Use degree=master or degree=doctor.}
  \fi
\fi
%    \end{macrocode}
%
% 获取 |degree-type| 的取值，并设置对应条件。
%
%    \begin{macrocode}
\edef\gzu@degree@type{\csname gzu@degree-type\endcsname}

\ifx\gzu@degree@type\gzu@academic
  \gzu@degree@type@academictrue
\else
  \ifx\gzu@degree@type\gzu@professional
    \gzu@degree@type@professionaltrue
  \else
    \ClassError{gzuthesis}
      {Invalid degree-type `\gzu@degree@type'}
      {Use degree-type=academic or degree-type=professional.}
  \fi
\fi
%    \end{macrocode}
%
% \subsection{基础文档类}
%
% GZUThesis 使用 |ctexbook| 作为基础文档类。
% 采用 UTF-8 编码和 A4 纸张。
%
%    \begin{macrocode}
\LoadClass[
  a4paper,
  UTF8,
  zihao=-4,
  scheme=plain,
  fontset=none,
  twoside
]{ctexbook}
%    \end{macrocode}
%

% \subsection{论文信息配置}
%
% GZUThesis 使用统一的 \cs{gzusetup} 命令配置论文信息。
% 配置项采用 |key=value| 形式，可以多次调用。
%
% \subsubsection{配置接口}
%
% 使用 |kvdefinekeys| 和 |kvsetkeys| 宏包实现键值配置。
%
%    \begin{macrocode}
\RequirePackage{kvdefinekeys}
\RequirePackage{kvsetkeys}

\newcommand\gzusetup[1]{%
  \kvsetkeys{gzuinfo}{#1}%
}
%    \end{macrocode}
%
