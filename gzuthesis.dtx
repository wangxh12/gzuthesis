%
% \section{模板介绍}
%
% GZUThesis 以贵州大学研究生学位论文为适用对象，
% 后续将逐步实现论文版式和相关功能。
%
% \section{安装方法}
%
% 在项目目录中执行：
% \begin{verbatim}
% xetex gzuthesis.ins
% xelatex gzuthesis.dtx
% \end{verbatim}
% 第一条命令提取文档类和开发文档样式，第二条编译本使用手册。
%
% \section{基本使用}
%
% 在论文主文件中加载文档类：
% \begin{verbatim}
% \documentclass{gzuthesis}
% \begin{document}
% \chapter{绪论}
% 测试文本。
% \end{document}
% \end{verbatim}
%
% \section{配置说明}
%
% \subsection{学位层次}
%
% |degree| 用于指定学位层次，支持以下选项：
%
% \begin{description}
%   \item[master] 硕士学位论文，默认值。
%   \item[doctor] 博士学位论文。
% \end{description}
%
% \subsection{学位类别}
%
% |degree-type| 用于指定学位类别，支持以下选项：
%
% \begin{description}
%   \item[academic] 学术学位，默认值。
%   \item[professional] 专业学位。
% \end{description}
%
% 例如，专业学位博士论文可以使用：
%
% \begin{verbatim}
% \documentclass[
%   degree=doctor,
%   degree-type=professional
% ]{gzuthesis}
% \end{verbatim}
%
% 论文标题、作者、导师等元数据配置接口
% 将在后续版本中实现。
% 
% \subsection{论文信息配置}
%
% 论文的基本信息通过 \cs{gzusetup} 命令统一设置。
%
% \begin{verbatim}
% \gzusetup{
%   title = {中文论文题目},
%   title* = {English Thesis Title},
%   author = {张三},
%   student-id = {2026000000},
%   supervisor = {李四 教授},
%   discipline = {机械工程},
%   research-direction = {智能故障诊断},
%   department = {机械工程学院},
%   date = {2026-11},
% }
% \end{verbatim}
%
% 其中 |title*| 表示英文论文题目。
% 如果配置值中包含英文逗号，应使用花括号包裹整个值。
%
% \cs{gzusetup} 可以多次调用，
% 后一次设置的同名配置项将覆盖之前的值。
%
% 其他可用配置项包括 |clc|（中图分类号）、
% |udc|（UDC 分类号）、|school-code|（学校代码）
% 和 |secret-level|（密级）。
% 
% 
% 
% \subsection{字体配置}
%
% GZUThesis 默认自动选择可用字体。
% 也可以通过 |fontset| 选项指定字体库。
%
% 支持 |auto|、|windows|、|mac|、
% |ubuntu| 和 |fandol|。
%
% \begin{verbatim}
% \documentclass[
%   degree=master,
%   degree-type=academic,
%   fontset=auto
% ]{gzuthesis}
% \end{verbatim}
%
% 正文字号暂采用小四号（12 bp），固定行距为 20 bp。
%
% \subsection{正文与章节标题}
%
% GZUThesis 默认采用 ThuThesis 的研究生论文排版方案。
%
% 中文正文采用宋体小四号字，固定行距为 20 bp，
% 段落首行缩进两个汉字符。
%
% 章标题采用黑体三号字，居中排列。
% 一级节标题采用黑体 14 bp，二级节标题采用黑体 13 bp，
% 三级节标题采用黑体 12 bp，均左对齐。
%
% 各级标题使用自动编号，支持编号至三级节标题。
% 
% 
% \subsection{页眉页脚}
%
% GZUThesis 采用双面排版，奇偶页使用不同的页眉。
%
% 奇数页页眉居中显示当前章编号及标题，
% 偶数页页眉根据学位类型显示
% “贵州大学硕士学位论文”或“贵州大学博士学位论文”。
%
% 页眉采用宋体五号字，下方设置 0.75 bp 的横线。
% 页脚居中显示页码，采用五号西文字体。
%
% 页眉距纸张上边缘 2.2 cm，
% 页脚距纸张下边缘 1.75 cm。
% 
% 
% \subsection{论文结构}
%
% GZUThesis 将论文划分为前置部分、正文部分和后置部分。
%
% \begin{verbatim}
% \begin{document}
%
% \frontmatter
% \chapter{摘要}
% \tableofcontents
%
% \mainmatter
% \chapter{绪论}
%
% \backmatter
% \chapter{参考文献}
% \chapter{致谢}
%
% \end{document}
% \end{verbatim}
%
% 前置部分采用大写罗马数字页码，
% 正文部分采用阿拉伯数字页码并重新从 1 开始，
% 后置部分延续正文页码。
% 
% 
% 
% 
% 
% \subsection{目录}
%
% 使用 \cs{tableofcontents} 命令生成论文目录。
%
% GZUThesis 默认显示章、节和小节三级目录，
% 目录条目采用小四号字，固定行距 20 bp。
%
% 章目录采用黑体，节和小节目录采用宋体，
% 分别缩进一个和两个汉字符。
%
% 目录条目与页码之间使用点线连接，
% 页码右对齐。
%
% 目录应至少编译两次，以正确更新目录内容及页码。
% 
% \subsection{数学公式}
%
% GZUThesis 使用 |amsmath| 和 |unicode-math|
% 实现数学公式排版。
%
% 默认数学字体为 XITS Math，
% 可通过 |math-font| 选项选择数学字体。
%
% \begin{verbatim}
% \documentclass[
%   math-font=xits
% ]{gzuthesis}
% \end{verbatim}
%
% 支持 |xits|、|stix| 和 |lm|。
%
% 公式默认按照章节编号，
% 使用中文全角括号。
%
% 公式编号连接符可以通过以下方式设置：
%
% \begin{verbatim}
% \gzusetup{
%   equation-number-separator = {-},
% }
% \end{verbatim}
%
% 公式交叉引用使用 \cs{label} 和 \cs{eqref}。
% 
% 

% \subsection{定理与证明环境}
%
% GZUThesis 使用 |amsthm| 宏包提供数学环境，
% 包括定理、定义、引理、命题、公理、推论等。
%
% 定理环境按照章节编号，
% 标题使用黑体，正文使用正常字体。
%
% 例如：
%
% \begin{verbatim}
% \begin{theorem}
%   对任意实数 $x$，均有 $x^2 \geq 0$。
% \end{theorem}
%
% \begin{proof}
%   根据实数的性质，命题成立。
% \end{proof}
% \end{verbatim}
%
% 使用 \cs{label} 和 \cs{ref}
% 可以实现定理、定义等环境的交叉引用。
%
% 证明结束时自动显示证明结束符号。
% 
% 
% \subsection{参考文献}
%
% GZUThesis 同时支持 BibTeX 和 BibLaTeX
% 两种参考文献处理方式，并提供顺序编码制
% 和著者—出版年制两种著录格式。
%
% 使用 BibTeX 时，应加载 |natbib| 宏包，
% 并通过 \cs{bibliographystyle} 指定文献样式。
%
% 使用 BibLaTeX 时，应通过 |style| 选项
% 指定文献样式，并使用 Biber 处理文献数据库。
%
% 本模板提供以下参考文献样式：
%
% \begin{itemize}
%   \item |gzuthesis-numeric|：顺序编码制；
%   \item |gzuthesis-author-year|：著者—出版年制。
% \end{itemize}
%
% 顺序编码制支持上标引用和正文引用。
% 用户可以使用 \cs{inlinecite} 输出行内引用。
%
% 参考文献列表采用五号字，固定行距 16 bp，
% 文献条目间距为 3 bp，并允许适当伸缩。
%
% 参考文献标题不参与章节编号，
% 但自动加入论文目录。
% 
% 
% \subsection{生成封面}
%
% GZUThesis 使用 \cs{maketitle} 自动生成学位论文封面。
% 封面信息通过 \cs{gzusetup} 命令设置。
%
% \begin{verbatim}
% \gzusetup{
%   graduation-year = {2027},
%   title = {中文论文题目},
%   title* = {English Thesis Title},
%   author = {张三},
%   date = {2026 年 10 月},
% }
%
% \begin{document}
% \maketitle
% \frontmatter
% ...
% \end{document}
% \end{verbatim}
%
% 模板根据 |degree| 和 |degree-type| 自动确定
% 学位层次及封面中的学位类别标识。
% 
% 

% \subsection{致谢}
%
% GZUThesis 提供 |acknowledgements| 环境。
% 致谢不参与章节编号，但自动加入目录。
%
% \begin{verbatim}
% \begin{acknowledgements}
% 感谢导师和同学的帮助。
% \end{acknowledgements}
% \end{verbatim}
%
% \subsection{附录}
%
% 使用 \cs{appendix} 命令开启附录。
% 附录按照 A、B、C 等大写英文字母编号。
%
% \begin{verbatim}
% \appendix
%
% \chapter{补充实验数据}
%
% \chapter{补充数学证明}
% \end{verbatim}
%
% 附录的图、表和公式按照附录编号独立编号，
% 例如 A.1、A.2、B.1 等。
%
% 目录默认只显示附录章标题。
% 

% \subsection{图表编号、双语题注与三线表}
%
% 图、表和公式默认按章编号，采用短横线连接。
% 附录相应为 A-1 等；章节和定理编号保持不变。
% 可以在导言区统一覆盖默认值：
%
% \begin{verbatim}
% \gzusetup{
%   figure-number-separator = {-},
%   table-number-separator = {-},
%   equation-number-separator = {-},
%   table-rule-width = {1.5bp},
%   table-midrule-width = {0.75bp},
%   table-cmidrule-width = {0.75bp},
%   caption-language = auto,
% }
% \end{verbatim}
%
% 连接符分别影响图、表和公式及其交叉引用，不修改章节或定理编号。
% |table-rule-width| 控制 \cs{toprule} 和 \cs{bottomrule}；
% 另外两项分别控制 \cs{midrule} 和 \cs{cmidrule}。
% 不改变普通 \cs{hline}，命令上的显式线宽参数仍有优先级。
%
% 题注语言支持三种模式：
% \begin{description}
%   \item[auto] 默认值；硕士只显示中文，博士显示中英文。
%   \item[chinese] 只显示中文，忽略已填写的英文题目。
%   \item[bilingual] 显示中文和英文，适用于任意学位层次。
% \end{description}
%
% \cs{gzucaption} 接收中文和英文题目两个必选参数。
% 双语模式下英文不能为空；模板不自动翻译。
% 中文模式下可将英文参数留空，也可保留英文以便后续切换。
%
% \begin{verbatim}
% \gzucaption{无人机飞行状态}{UAV flight states}
% \label{fig:flight}
%
% % Chinese-only mode
% \gzucaption{无人机飞行状态}{}
%
% % Optional short Chinese entry in the list
% \gzucaption[飞行状态]{无人机飞行状态变化曲线}
%   {Changes in UAV flight states}
% \end{verbatim}
%
% 双语题注中文在上、英文在下，共享一个编号。
% 图表清单只收录中文条目；标签放在题注命令之后。
% 此选项也控制原生 \cs{bicaption} 的语言显示，
% 但不把普通 \cs{caption} 自动转换成双语。
% 缺少英文的检查只对 \cs{gzucaption} 生效。
% 博士使用 |chinese| 仍可编译，但会收到警告。
%
% 跨页表格使用原生 \cs{bicaption}，题注行以 |\\| 结束。
% 其英文内容由作者自行检查。
%
% \begin{verbatim}
% \begin{longtable}{ll}
% \bicaption{实验数据}{Experimental data}
% \label{tab:data}\\
% \toprule
% Item & Value \\
% \midrule
% ...
% \bottomrule
% \end{longtable}
% \end{verbatim}
% 
% 
% 
% 
% 
% 
% 
