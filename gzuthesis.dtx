% \subsection{PDF 书签导航}
% \label{sec:pdf-bookmarks}
%
% PDF 书签与正文目录保持一致，
% 显示到 subsection 层级（如 1.1.1）。
%
% 书签自动包含章节编号，并采用可展开的树形结构。
% 不编号的摘要、图表清单等保持无编号。
%
% hyperref 由用户在导言区加载，
% 本模板在宏包加载完成后应用书签配置。
%
%    \begin{macrocode}
\PassOptionsToPackage{
  linktoc=all,
  bookmarksnumbered=true,
  bookmarksopen=true,
  bookmarksopenlevel=2,
  bookmarksdepth=2,
  unicode=true,
  psdextra=true,
  breaklinks=true,
  plainpages=false,
  pdfdisplaydoctitle=true,
  hidelinks,
}{hyperref}
\AddToHook{package/hyperref/after}{%
  \hypersetup{
    pdflang=zh-CN,
    pdfpagemode=UseOutlines,
  }%
  \pdfstringdefDisableCommands{%
    \let\\\relax
    \let\quad\relax
    \let\qquad\relax
    \let\hspace\@gobble
  }%
  \AddToHook{begindocument/before}{%
    \hypersetup{
      pdftitle={\gzu@title},
      pdfauthor={\gzu@author},
      pdfsubject={\gzu@discipline},
      pdfkeywords={\gzu@keywords},
      pdfcreator={GZUThesis v\gzuversion},
    }%
  }%
}
%    \end{macrocode}
