% \subsection{数学公式}
% \label{sec:math}
%
% GZUThesis 参考 ThuThesis 的数学排版方案，
% 使用 |amsmath| 提供公式环境，
% 使用 |unicode-math| 配置数学字体和符号样式。
%
% \subsubsection{数学宏包}
%
% 加载数学公式宏包。
%
%    \begin{macrocode}
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
