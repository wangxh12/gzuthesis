% \subsection{定理与证明环境}
% \label{sec:theorem}
%
% GZUThesis 参考 ThuThesis 的定理排版方式，
% 使用 |amsthm| 宏包定义常用数学环境。
%
% \subsubsection{加载宏包}
%
% 使用 |amsthm| 提供定理、定义与证明环境。
%
%    \begin{macrocode}
\RequirePackage{amsthm}
%    \end{macrocode}
%
% \subsubsection{定理样式}
%
% 定理标题使用黑体，正文使用正常字体，
% 标题与正文之间使用中文冒号。
%
% 定理上下间距均为 0，
% 标题与正文之间留出 0.5 em 的水平间距。
%
%    \begin{macrocode}
\newcommand\gzu@theorem@separator{：}

\newtheoremstyle{gzu}
  {0pt}
  {0pt}
  {\normalfont}
  {0pt}
  {\normalfont\sffamily}
  {\gzu@theorem@separator}
  {0.5em}
  {}

\theoremstyle{gzu}
%    \end{macrocode}
%
% \subsubsection{定理环境定义}
%
% 定义常用的数学环境，包括假设、定义、
% 命题、引理、定理、公理、推论等。
%
% 各环境采用独立计数器，均按照章节编号。
%
%    \begin{macrocode}
\newtheorem{assumption}{假设}[chapter]
\newtheorem{definition}{定义}[chapter]
\newtheorem{proposition}{命题}[chapter]
\newtheorem{lemma}{引理}[chapter]
\newtheorem{theorem}{定理}[chapter]
\newtheorem{axiom}{公理}[chapter]
\newtheorem{corollary}{推论}[chapter]
\newtheorem{exercise}{练习}[chapter]
\newtheorem{example}{例}[chapter]
\newtheorem{remark}{注释}[chapter]
\newtheorem{problem}{问题}[chapter]
\newtheorem{conjecture}{猜想}[chapter]
%    \end{macrocode}
%
% \subsubsection{证明环境}
%
% 重新定义 |proof| 环境。
% 证明标题采用黑体，证明正文采用正常字体。
% 证明结束后自动添加结束符号。
%
%    \begin{macrocode}
\renewenvironment{proof}[1][证明]{%
  \par
  \pushQED{\qed}%
  \normalfont
  \topsep0pt\relax
  \trivlist
  \item[\hskip\labelsep\sffamily #1]\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}
%    \end{macrocode}
%
% \subsubsection{证明结束符号}
%
% 采用 |unicode-math| 提供的 QED 符号。
%
%    \begin{macrocode}
\renewcommand\qedsymbol{\ensuremath{\QED}}
%    \end{macrocode}
