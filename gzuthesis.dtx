      ：\hspace{0.5\ccwd}%
      #4%
    };%
}
% 右上角：标签统一按四个汉字宽度对齐
\newcommand\gzu@cover@right@row[3]{%
  \node[anchor=base east] at
    ([xshift=-25mm,yshift=-#1mm]current page.north east) {%
      \gzu@cover@song\gzu@cover@times
      \fontsize{12bp}{16bp}\selectfont
