
% \section{实现细节}
%
% \subsection{基本信息}
%
% 声明 GZUThesis 文档类。
%
%    \begin{macrocode}
%<*cls>
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{gzuthesis}
  [2026/11/15 v0.1 Guizhou University Thesis Template]
%    \end{macrocode}
%
% \subsection{定义选项}
%
% GZUThesis 仅支持硕士和博士学位论文，
% 并区分学术学位和专业学位。
%
%    \begin{macrocode}
\RequirePackage{kvoptions}
\RequirePackage{etoolbox}

\SetupKeyvalOptions{
  family = gzu,
  prefix = gzu@,
}

\DeclareStringOption[master]{degree}
\DeclareStringOption[academic]{degree-type}

\DeclareDefaultOption{
  \PassOptionsToClass{\CurrentOption}{ctexbook}
}

\ProcessKeyvalOptions*
%    \end{macrocode}
%
% \subsection{学位类型判断}
%
% 定义内部布尔条件，供后续排版代码使用。
%
%    \begin{macrocode}
\newif\ifgzu@degree@master
\newif\ifgzu@degree@doctor

\newif\ifgzu@degree@type@academic
\newif\ifgzu@degree@type@professional
%    \end{macrocode}
%
% 检查学位层次。
%
%    \begin{macrocode}
\ifdefstring{\gzu@degree}{master}
  {\gzu@degree@mastertrue}
  {
    \ifdefstring{\gzu@degree}{doctor}
      {\gzu@degree@doctortrue}
      {
        \ClassError{gzuthesis}
          {Invalid degree `\gzu@degree'}
          {Use degree=master or degree=doctor.}
      }
  }
%    \end{macrocode}
%
% 检查学位类别。
%
%    \begin{macrocode}
\edef\gzu@degree@type{
  \csname gzu@degree-type\endcsname
}

\ifdefstring{\gzu@degree@type}{academic}
  {\gzu@degree@type@academictrue}
  {
    \ifdefstring{\gzu@degree@type}{professional}
      {\gzu@degree@type@professionaltrue}
      {
        \ClassError{gzuthesis}
          {Invalid degree-type `\gzu@degree@type'}
          {Use degree-type=academic or professional.}
      }
  }
%    \end{macrocode}
%
% \subsection{加载基础文档类}
%
% 采用 ctexbook 作为基础文档类。
%
%    \begin{macrocode}
\LoadClass[a4paper,UTF8]{ctexbook}
%</cls>
%    \end{macrocode}
