% 引导点及页码格式。
%
% \subsubsection{目录基本设置}
%
% 目录显示到 |subsection| 层级，
% 即章、节、小节三级。
%
%    \begin{macrocode}
\RequirePackage{titletoc}

\setcounter{tocdepth}{2}
\renewcommand\contentsname{目\quad 录}
%    \end{macrocode}
%
% \subsubsection{目录生成命令}
%
% 重新定义 \cs{tableofcontents}，
% 使用不编号的章标题生成目录首页。
% 目录自身不加入目录。
%
%    \begin{macrocode}
\renewcommand\tableofcontents{%
  \chapter*{\contentsname}%
  \markboth{\contentsname}{\contentsname}%
  \begingroup
    \setlength{\parskip}{0pt}%
    \@starttoc{toc}%
  \endgroup
}
%    \end{macrocode}
%
% \subsubsection{目录引导线}
%
% 目录条目与页码之间使用点线连接。
