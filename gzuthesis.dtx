%
% 页眉居中显示当前章编号及标题，
% 采用宋体五号字。
%
%    \begin{macrocode}
% 奇数页：显示当前章编号及标题
  \fancyhead[CO]{%
    \songti
    \fontsize{10.5bp}{12.1bp}\selectfont
    \nouppercase{\leftmark}%
  }%
% 偶数页：根据学位类型显示论文名称
  \fancyhead[CE]{%
    \songti
    \fontsize{10.5bp}{12.1bp}\selectfont
