\renewenvironment{proof}[1][证明]{%
  \par
  \pushQED{\qed}%
  \normalfont
  \topsep0pt\relax
  \trivlist
  \item[\hskip\labelsep\sffamily #1]\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}
