%
% \subsection{列表、脚注与 URL}
% \label{sec:lists-footnotes}
%
% 借鉴 ThuThesis 对中文论文脚注和列表的处理。
% 为保持 GZUThesis 既有输出，脚注默认按章使用普通数字，
% 亦可在文档类选项中启用按页编号或带圈数字。
%
%    \begin{macrocode}
\RequirePackage{enumitem}
\setlist{nosep}
\RequirePackage{xurl}
\urlstyle{same}
\Urlmuskip=0mu plus 0.1mu
\interfootnotelinepenalty=10000

\ifgzu@footnote@numbering@page
  \PassOptionsToPackage{perpage}{footmisc}%
\fi
\RequirePackage[hang]{footmisc}
\ifgzu@footnote@numbering@global
  \@removefromreset{footnote}{chapter}%
\fi
\newcommand\gzu@circled[1]{%
  \ifnum#1>10\relax
    \ClassWarningNoLine{gzuthesis}{More than ten circled footnotes on a page}%
  \fi
  \textcircled{#1}%
}
\ifgzu@footnote@style@circled
  \renewcommand\thefootnote{\gzu@circled{\arabic{footnote}}}%
  \renewcommand\thempfootnote{\gzu@circled{\arabic{mpfootnote}}}%
\fi
\def\footnoterule{%
  \vskip-3\p@\hrule\@width0.3\textwidth\@height0.4\p@\vskip2.6\p@
}
\footnotemargin=13.5bp
% 参考 ThuThesis：脚注正文小五号，悬挂式，编号不使用上标。
\long\def\@makefntext#1{%
  \begingroup
    \def\@makefnmark{\hbox{\normalfont\@thefnmark}}%
    \xiaowu
    \ifFN@hangfoot
      \bgroup
      \setbox\@tempboxa\hbox{%
        \ifdim\footnotemargin>\z@
          \hb@xt@\footnotemargin{\@makefnmark\hss}%
        \else
          \@makefnmark
        \fi
      }%
      \leftmargin\wd\@tempboxa
      \rightmargin\z@
      \linewidth\columnwidth
      \advance\linewidth-\leftmargin
      \parshape\@ne\leftmargin\linewidth
      \xiaowu
      \@setpar{{\@@par}}%
      \leavevmode
      \llap{\box\@tempboxa}%
      \parskip\hangfootparskip\relax
      \parindent\hangfootparindent\relax
    \else
      \parindent1em\noindent
      \hb@xt@\footnotemargin{\hss\@makefnmark}%
    \fi
    \footnotelayout#1%
    \ifFN@hangfoot
      \par\egroup
    \fi
  \endgroup
}
%    \end{macrocode}
%
% \subsection{章节标题}
% \label{sec:section}
%
% 参考 ThuThesis 研究生学位论文的章节标题设置。
% 章标题居中，节及以下各级标题左对齐。
%
% \subsubsection{标题格式}
%
% 章标题采用黑体三号字，段前和段后均为 27 bp。
% 章序号采用阿拉伯数字，标题形式为“第 1 章 绪论”。
%
% 一级节标题采用黑体 14 bp，段前 24 bp，段后 6 bp。
% 二级节标题采用黑体 13 bp，段前 12 bp，段后 6 bp。
% 三级节标题采用黑体 12 bp，段前 12 bp，段后 6 bp。
%
%    \begin{macrocode}
\ctexset{
  chapter = {
    name         = {第,章},
    number       = \thechapter,
    format       = \centering\sffamily
                   \fontsize{16bp}{20.8bp}\selectfont,
    nameformat   = {},
    numberformat = {},
    titleformat  = {},
    aftername    = \quad,
    beforeskip   = 27bp,
    afterskip    = 27bp,
    fixskip      = true,
    afterindent  = true,
  },
  section = {
    format       = \sffamily
                   \fontsize{14bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 24bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
  subsection = {
    format       = \sffamily
                   \fontsize{13bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 12bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
  subsubsection = {
    format       = \sffamily
                   \fontsize{12bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 12bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
}
%    \end{macrocode}
%
% \subsubsection{标题编号深度}
%
% 正文标题编号到三级节标题，
% 即 |subsubsection| 层级。
%
%    \begin{macrocode}
\setcounter{secnumdepth}{3}
%    \end{macrocode}
% 
% 
% \subsection{页眉页脚}
% \label{sec:headerfooter}
%
% GZUThesis 参考 ThuThesis 的研究生学位论文样式，
% 使用 |fancyhdr| 宏包设置页眉和页脚。
%
% 页眉采用宋体五号字，居中显示当前章编号及标题，
% 下方设置 0.75 bp 的横线。
% 页脚采用五号西文字体，页码居中显示。
%
% \subsubsection{加载宏包}
%
% 首先激活 |fancy| 页面样式，
% 避免后续配置章节标记时被默认设置覆盖。
%
%    \begin{macrocode}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
%    \end{macrocode}
%
% \subsubsection{定义页面样式}
%
% 使用 |plain| 作为论文的基本页面样式。
%
%    \begin{macrocode}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand\headrulewidth{0.75bp}%
  \renewcommand\footrulewidth{0pt}%
%    \end{macrocode}
%
% 页眉居中显示当前章编号及标题，
% 采用宋体五号字。
%
%    \begin{macrocode}
% 奇数页：显示当前章编号及标题
  \fancyhead[CO]{%
    \songti
    \fontsize{10.5bp}{12.1bp}\selectfont
    \nouppercase{\leftmark}%
  }%
% 偶数页：根据学位类型显示论文名称
  \fancyhead[CE]{%
    \songti
    \fontsize{10.5bp}{12.1bp}\selectfont
    \ifgzu@degree@doctor
      贵州大学博士学位论文%
    \else
      贵州大学硕士学位论文%
    \fi
  }%
%    \end{macrocode}
%
% 页脚居中显示页码，采用五号西文字体。
%
%    \begin{macrocode}
  \fancyfoot[C]{%
    \rmfamily
    \fontsize{10.5bp}{12.1bp}\selectfont
    \thepage
  }%
%    \end{macrocode}
%
% \subsubsection{章节标记}
%
% 重新定义章节标记，仅在页眉显示当前章的信息，
% 不显示节标题。
%
%    \begin{macrocode}
  \let\@mkboth\markboth
  \def\chaptermark##1{%
    \markboth{%
      \CTEXifname{\CTEXthechapter\quad}{}##1%
    }{}%
  }%
  \let\sectionmark\@gobble
}
%    \end{macrocode}
%
% \subsubsection{应用页面样式}
%
% 将 |plain| 设置为默认页面样式，
% 并应用于章首页。
%
%    \begin{macrocode}
\pagestyle{plain}
\ctexset{
  chapter/pagestyle = plain,
}
%    \end{macrocode}
%    
% 

% \subsection{主文档结构}
% \label{sec:mainmatter}
%
% GZUThesis 参考 ThuThesis，采用 |frontmatter|、
% |mainmatter| 和 |backmatter| 三个命令划分论文结构。
%
% \subsubsection{双面分页处理}
%
% 对于双面排版，章节通常从奇数页开始。
% 当需要插入空白页时，不显示页眉、页脚和页码。
%
%    \begin{macrocode}
% 双面分页处理
% print      : 必要时补充空白页，保证右页起始
% electronic : 只结束当前页，不额外补充空白页
\renewcommand\cleardoublepage{%
  \clearpage
  \if@twoside
    \ifgzu@output@print
      \ifodd\c@page
      \else
        \thispagestyle{empty}%
        \hbox{}%
        \newpage
        \if@twocolumn
          \hbox{}\newpage
        \fi
      \fi
    \fi
  \fi
}
%    \end{macrocode}
%
% \subsubsection{前置部分}
%
% 前置部分不对章节编号，页码采用大写罗马数字。
% 进入前置部分时，页码从 I 开始。
%
%    \begin{macrocode}
\renewcommand\frontmatter{%
  \cleardoublepage
  \@mainmatterfalse
  \pagenumbering{Roman}%
}
%    \end{macrocode}
%
% \subsubsection{正文部分}
%
% 正文部分启用章节编号，页码采用阿拉伯数字。
% 进入正文部分时，页码从 1 开始。
%
%    \begin{macrocode}
\renewcommand\mainmatter{%
  \cleardoublepage
  \@mainmattertrue
  \pagenumbering{arabic}%
}
%    \end{macrocode}
%
% \subsubsection{后置部分}
%
% 后置部分不对章节编号，页码延续正文部分。
% 具体目录深度将在目录模块中设置。
%
%    \begin{macrocode}
\renewcommand\backmatter{%
  \clearpage
  \@mainmatterfalse
}
%    \end{macrocode}
% 
% 
% \subsubsection{未编号章节的统一处理}
%
% 用于摘要、致谢、符号对照表、参考文献等。
% 在生成章节标题之前建立 PDF 跳转锚点，
% 保证目录链接和书签跳转到章节顶部。
%
% 第一个参数：页面显示的标题
% 第二个参数：目录与页眉使用的标题
%
%    \begin{macrocode}
\newcommand\gzu@unnumbered@chapter[2]{%
  % 先切换到目标章节所在页面
  \if@openright
    \cleardoublepage
  \else
    \clearpage
  \fi
  % 在章节标题之前建立跳转锚点
  \@ifpackageloaded{hyperref}{\phantomsection}{}%
  % 记录目录和 PDF 书签
  \addcontentsline{toc}{chapter}{#2}%
  % 生成未编号章节标题
  \chapter*{#1}%
  % 设置页眉
  \markboth{#2}{#2}%
}
%    \end{macrocode}
