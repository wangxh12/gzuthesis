%
% \subsubsection{数学符号样式}
%
% 参考 ThuThesis 中文论文的数学符号规则，
% 采用 ISO 风格的字母和粗体变量，
% 偏微分符号使用正体。
%
%    \begin{macrocode}
\unimathsetup{
  math-style = ISO,
  bold-style = ISO,
  partial    = upright,
}
%    \end{macrocode}
%
% 小于等于号和大于等于号采用倾斜形式。
%
%    \begin{macrocode}
\AtBeginDocument{%
  \let\le\leqslant
  \let\ge\geqslant
  \let\leq\leqslant
  \let\geq\geqslant
}
%    \end{macrocode}
%
% \subsubsection{数学字体}
%
% 默认采用 XITS Math。
% 同时支持 STIX Two Math 和 Latin Modern Math。
%
%    \begin{macrocode}
\edef\gzu@math@font{%
  \csname gzu@math-font\endcsname
}

\def\gzu@math@font@xits{xits}
\def\gzu@math@font@stix{stix}
\def\gzu@math@font@lm{lm}
%    \end{macrocode}
%
% 根据文档类选项加载对应数学字体。
%
%    \begin{macrocode}
\ifx\gzu@math@font\gzu@math@font@xits
  \setmathfont{XITSMath-Regular.otf}[
    BoldFont = XITSMath-Bold.otf,
    StylisticSet = 8,
  ]
\else
  \ifx\gzu@math@font\gzu@math@font@stix
    \setmathfont{STIXTwoMath-Regular.otf}
  \else
    \ifx\gzu@math@font\gzu@math@font@lm
      \setmathfont{latinmodern-math.otf}
    \else
      \ClassError{gzuthesis}
        {Invalid math font `\gzu@math@font'}
        {Use math-font=xits, stix or lm.}
    \fi
  \fi
\fi
%    \end{macrocode}
