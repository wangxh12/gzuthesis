%
%    \begin{macrocode}
\titlecontents{chapter}
  [0pt]
  {\sffamily\fontsize{12bp}{20bp}\selectfont}
  {\contentspush{\thecontentslabel\quad}}
  {}
  {\rmfamily\gzu@toc@leaders\thecontentspage}
%    \end{macrocode}
