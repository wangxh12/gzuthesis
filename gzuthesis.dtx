% \subsection{章节标题}
% \label{sec:section}
%
% 参考 ThuThesis 研究生学位论文的章节标题设置。
% 章标题居中，节及以下各级标题左对齐。
%
% \subsubsection{标题格式}
%
% 章标题采用黑体三号字，段前和段后均为 27 bp。
% 章序号采用阿拉伯数字，标题形式为“第 1 章 绪论”。
%
% 一级节标题采用黑体 14 bp，段前 24 bp，段后 6 bp。
% 二级节标题采用黑体 13 bp，段前 12 bp，段后 6 bp。
% 三级节标题采用黑体 12 bp，段前 12 bp，段后 6 bp。
%
%    \begin{macrocode}
\ctexset{
  chapter = {
    name         = {第,章},
    number       = \thechapter,
    format       = \centering\sffamily
                   \fontsize{16bp}{20.8bp}\selectfont,
    nameformat   = {},
    numberformat = {},
    titleformat  = {},
    aftername    = \quad,
    beforeskip   = 27bp,
    afterskip    = 27bp,
    fixskip      = true,
    afterindent  = true,
  },
  section = {
    format       = \sffamily
                   \fontsize{14bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 24bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
  subsection = {
    format       = \sffamily
                   \fontsize{13bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 12bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
  subsubsection = {
    format       = \sffamily
                   \fontsize{12bp}{20bp}\selectfont,
    aftername    = \quad,
    beforeskip   = 12bp,
    afterskip    = 6bp,
    afterindent  = true,
  },
}
%    \end{macrocode}
