% \subsection{页面布局}
% \label{sec:layout}
%
% GZUThesis 统一采用 A4 纸张，尺寸为
% $\SI{210}{mm} \times \SI{297}{mm}$。
%
% 页面边距设置如下：
% \begin{itemize}
%   \item 上边距：3.0 cm；
%   \item 下边距：2.5 cm；
%   \item 左边距：2.5 cm；
%   \item 右边距：2.5 cm；
%   \item 页眉距纸张上边缘：2.2 cm；
%   \item 页脚距纸张下边缘：1.75 cm。
% \end{itemize}
%
% 使用 |geometry| 宏包设置页面布局。
% 页眉、页脚及装订相关参数将在后续模块中配置。
%
%    \begin{macrocode}
\RequirePackage{geometry}

\geometry{
  paper      = a4paper,
  top        = 3cm,
  bottom     = 2.5cm,
  left       = 2.5cm,
  right      = 2.5cm,
  headheight = 0.5cm,
  headsep    = 0.3cm,
  footskip   = 0.75cm,
}
%    \end{macrocode}
%
% \subsection{字体设置}
% \label{sec:font}
%
% GZUThesis 参考 ThuThesis 配置中西文字体。
% 根据系统中可用的字体自动选择合适的字体库。
%
% \subsubsection{西文字体}
%
% 在 XeLaTeX 下通过字体文件名加载 TeX Gyre 字体，
% 避免依赖操作系统的字体名称检索机制。
%
% 正文字体采用 TeX Gyre Termes。
%
%    \begin{macrocode}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}

\setmainfont{texgyretermes-regular.otf}[
  BoldFont       = texgyretermes-bold.otf,
  ItalicFont     = texgyretermes-italic.otf,
  BoldItalicFont = texgyretermes-bolditalic.otf,
]
%    \end{macrocode}
%
% 无衬线字体采用 TeX Gyre Heros。
%
%    \begin{macrocode}
\setsansfont{texgyreheros-regular.otf}[
  BoldFont       = texgyreheros-bold.otf,
  ItalicFont     = texgyreheros-italic.otf,
  BoldItalicFont = texgyreheros-bolditalic.otf,
]
%    \end{macrocode}
%
% 等宽字体采用 TeX Gyre Cursor。
%
%    \begin{macrocode}
\setmonofont{texgyrecursor-regular.otf}[
  BoldFont       = texgyrecursor-bold.otf,
  ItalicFont     = texgyrecursor-italic.otf,
  BoldItalicFont = texgyrecursor-bolditalic.otf,
]
%    \end{macrocode}
%
% \subsubsection{中文字体}
%
% 支持 Windows、macOS、思源和 Fandol 字体库。
% 默认通过 |fontset=auto| 自动选择。
%
%    \begin{macrocode}
\def\gzu@fontset@auto{auto}
\def\gzu@fontset@windows{windows}
\def\gzu@fontset@mac{mac}
\def\gzu@fontset@ubuntu{ubuntu}
\def\gzu@fontset@fandol{fandol}

\ifx\gzu@fontset\gzu@fontset@auto
  \IfFontExistsTF{SimSun}{
    \def\gzu@fontset{windows}
  }{
    \IfFontExistsTF{Songti SC}{
      \def\gzu@fontset{mac}
    }{
      \IfFontExistsTF{Noto Serif CJK SC}{
        \def\gzu@fontset{ubuntu}
      }{
        \def\gzu@fontset{fandol}
      }
    }
  }
\fi
%    \end{macrocode}
%
% Windows 中易字体。
%
%    \begin{macrocode}
\ifx\gzu@fontset\gzu@fontset@windows
  \setCJKmainfont{SimSun}[
    AutoFakeBold = 3,
    ItalicFont = KaiTi
  ]
  \setCJKsansfont{SimHei}[AutoFakeBold=3]
  \setCJKmonofont{FangSong}
  \setCJKfamilyfont{zhsong}{SimSun}[AutoFakeBold=3]
  \setCJKfamilyfont{zhhei}{SimHei}[AutoFakeBold=3]
  \setCJKfamilyfont{zhkai}{KaiTi}
  \setCJKfamilyfont{zhfs}{FangSong}
%    \end{macrocode}
%
% macOS 华文字体。
%
%    \begin{macrocode}
\else\ifx\gzu@fontset\gzu@fontset@mac
  \setCJKmainfont{Songti SC}
  \setCJKsansfont{Heiti SC}
  \setCJKmonofont{STFangsong}
  \setCJKfamilyfont{zhsong}{Songti SC}
  \setCJKfamilyfont{zhhei}{Heiti SC}
  \setCJKfamilyfont{zhkai}{Kaiti SC}
  \setCJKfamilyfont{zhfs}{STFangsong}
%    \end{macrocode}
%
% Linux 环境中的思源字体。
%
%    \begin{macrocode}
\else\ifx\gzu@fontset\gzu@fontset@ubuntu
  \setCJKmainfont{Noto Serif CJK SC}[
    ItalicFont = FandolKai-Regular.otf
  ]
  \setCJKsansfont{Noto Sans CJK SC}
  \setCJKmonofont{FandolFang-Regular.otf}
  \setCJKfamilyfont{zhsong}{Noto Serif CJK SC}
  \setCJKfamilyfont{zhhei}{Noto Sans CJK SC}
  \setCJKfamilyfont{zhkai}{FandolKai-Regular.otf}
  \setCJKfamilyfont{zhfs}{FandolFang-Regular.otf}
%    \end{macrocode}
%
% TeX Live 提供的 Fandol 字体。
%
%    \begin{macrocode}
\else\ifx\gzu@fontset\gzu@fontset@fandol
  \setCJKmainfont{FandolSong}[
    Extension = .otf,
    UprightFont = *-Regular,
    BoldFont = *-Bold
  ]
  \setCJKsansfont{FandolHei}[
    Extension = .otf,
    UprightFont = *-Regular,
    BoldFont = *-Bold
  ]
  \setCJKmonofont{FandolFang}[
    Extension = .otf,
    UprightFont = *-Regular
  ]
  \setCJKfamilyfont{zhsong}{FandolSong}[
    Extension = .otf,
    UprightFont = *-Regular,
    BoldFont = *-Bold
  ]
  \setCJKfamilyfont{zhhei}{FandolHei}[
    Extension = .otf,
    UprightFont = *-Regular,
    BoldFont = *-Bold
  ]
  \setCJKfamilyfont{zhkai}{FandolKai}[
    Extension = .otf,
    UprightFont = *-Regular
  ]
  \setCJKfamilyfont{zhfs}{FandolFang}[
    Extension = .otf,
    UprightFont = *-Regular
  ]
\else
  \ClassError{gzuthesis}
    {Invalid fontset `\gzu@fontset'}
    {Use auto, windows, mac, ubuntu or fandol.}
\fi\fi\fi\fi

\providecommand\songti{\CJKfamily{zhsong}}
\providecommand\heiti{\CJKfamily{zhhei}}
\providecommand\kaishu{\CJKfamily{zhkai}}
\providecommand\fangsong{\CJKfamily{zhfs}}
