%
% \section{模板介绍}
%
% GZUThesis 以贵州大学研究生学位论文为适用对象，
% 后续将逐步实现论文版式和相关功能。
%
% \section{安装方法}
%
% 在项目目录中执行：
% \begin{verbatim}
% xetex gzuthesis.ins
% xelatex gzuthesis.dtx
% \end{verbatim}
% 第一条命令提取文档类和开发文档样式，第二条编译本使用手册。
%
% \section{基本使用}
%
% 在论文主文件中加载文档类：
% \begin{verbatim}
% \documentclass{gzuthesis}
% \begin{document}
% \chapter{绪论}
% 测试文本。
% \end{document}
% \end{verbatim}
%
% \section{配置说明}
%
% \subsection{学位层次}
%
% |degree| 用于指定学位层次，支持以下选项：
%
% \begin{description}
%   \item[master] 硕士学位论文，默认值。
%   \item[doctor] 博士学位论文。
% \end{description}
%
% \subsection{学位类别}
%
% |degree-type| 用于指定学位类别，支持以下选项：
%
% \begin{description}
%   \item[academic] 学术学位，默认值。
%   \item[professional] 专业学位。
% \end{description}
%
% 例如，专业学位博士论文可以使用：
%
% \begin{verbatim}
% \documentclass[
%   degree=doctor,
%   degree-type=professional
% ]{gzuthesis}
% \end{verbatim}
%
% 论文标题、作者、导师等信息使用下述统一配置接口。
% 
% \subsection{论文信息配置}
%
% 论文的基本信息通过 \cs{gzusetup} 命令统一设置。
%
% \begin{verbatim}
% \gzusetup{
%   title = {中文论文题目},
%   title* = {English Thesis Title},
%   author = {张三},
%   student-id = {2026000000},
%   supervisor = {李四, 教授},
%   discipline = {电子信息},
%   research-direction = {自然语言处理},
%   department = {计算机科学与技术学院},
%   date = {2027-06-01},
% }
% \end{verbatim}
%
% 其中 |title*| 表示英文论文题目。
% 如果配置值中包含英文逗号，应使用花括号包裹整个值。
%
% \cs{gzusetup} 可以多次调用，
% 后一次设置的同名配置项将覆盖之前的值。
%
% 其他可用配置项包括 |clc|（中图分类号）、
% |udc|（UDC 分类号）、|school-code|（学校代码）
% 和 |secret-level|（密级）。
% 
% 
% 
% \subsection{字体与字号}
%
% GZUThesis 参考 ThuThesis 的字体方案、函数分发与字号命令，
% 同时保留贵州大学学位论文使用 Windows 原生字体的默认要求。
% 西文字体默认 Times New Roman（无衬线为 Arial、等宽为 Courier New），
% 中文正文默认 SimSun、标题使用 SimHei。
% 缺少这些字体时必须安装字体，或在项目自己的字体文件目录中提供相应文件；
% |auto| 不会暗中将默认字体换为外观相似的字体。
%
% \begin{description}
%   \item[fontset] 整体字体方案：|auto|（默认）、|windows|、
%     |windows-local|、|mac|、|ubuntu|、|fandol|、|none|。
%     |ubuntu|、|fandol| 仅在用户显式选择时生效。
%   \item[font] 西文字体：|auto|（默认）、|times|、|times-local|、
%     |termes|、|stix|、|xits|、|libertinus|、|newcm|、|lm|、|none|。
%   \item[cjk-font] 中文字体：|auto|（默认）、|windows|、
%     |windows-local|、|mac|、|mac-word|、|noto|、|fandol|、|none|。
%   \item[windows-font-dir] Windows 字体文件目录；默认 |.|（当前编译目录）。
%     这是用户指定的任意相对或绝对路径，模板不写死操作系统目录。
%   \item[math-font] 数学字体：|auto|（默认为 XITS Math）、|xits|、
%     |stix|、|libertinus|、|newcm|、|lm|、|none|。
% \end{description}
%
% 例如，Windows 或已注册 Windows 字体的环境可使用：
% \begin{verbatim}
% \documentclass[degree=master, fontset=windows]{gzuthesis}
% \end{verbatim}
% 在项目自带 Windows 字体文件的环境中：
% \begin{verbatim}
% \documentclass[
%   fontset=windows-local,
%   windows-font-dir={./fonts},
%   math-font=xits
% ]{gzuthesis}
% \end{verbatim}
% 也可以分别指定西文字体和中文字体，独立配置优先于整体方案。
% 模板默认不自动下载任何字体，也不随模板分发受第三方许可保护的字体文件。
%
% \subsubsection{字号}
%
% Word 的中文字号单位相当于 bp（Big Point），而不是 TeX 原生 pt。
% $1\,\mathrm{bp}=72.27/72\,\mathrm{pt}$。
% 下表列出常见中文字号，参考 ThuThesis；|10.5bp| 的 pt 值已按公式修正。
%
% \begin{center}
% \begin{tabular}{lrr}
% \toprule
% 中文字号 & bp & TeX pt \\
% \midrule
% 初号 & 42 & 42.1575 \\
% 小初 & 36 & 36.1350 \\
% 一号 & 26 & 26.0975 \\
% 小一 & 24 & 24.0900 \\
% 二号 & 22 & 22.0825 \\
% 小二 & 18 & 18.0675 \\
% 三号 & 16 & 16.0600 \\
% 小三 & 15 & 15.05625 \\
% 四号 & 14 & 14.0525 \\
% 小四 & 12 & 12.0450 \\
% 五号 & 10.5 & 10.539375 \\
% 小五 & 9 & 9.03375 \\
% \bottomrule
% \end{tabular}
% \end{center}
%
% 正文固定为 12bp、行距 20bp；其他字号提供 \cs{sanhao}、
% \cs{sihao}、\cs{xiaosi}、\cs{wuhao} 等中文字号命令，
% 可使用可选参数修改行距倍数（默认 1.3），例如 \verb|\sanhao[1.5]|。
% 与学校规定不一致的任意行距应继续用 \cs{fontsize} 精确指定。
%
% \subsection{脚注、列表与浮动体}
%
% 参考 ThuThesis 为脚注、列表及图表浮动体提供统一的间距规则。
% 脚注内容为小五号，采用悬挂缩进，并禁止单条脚注跨页。
% |footnote-numbering| 支持 |chapter|（默认）、|page| 和 |global|，
% |footnote-style| 支持 |plain|（默认）和 |circled|。
% 这两个选项在 \cs{documentclass} 中设置。
% 列表默认收紧垂直间距，图表默认尝试 |htbp| 位置。
% 图、表、公式的 |figure-numbering|、|table-numbering|、
% |equation-numbering| 可分别选 |chapter|（默认）或 |global|；
% 学位论文建议使用学校默认的按章编号。
%
% \subsection{正文与章节标题}
%
% GZUThesis 默认采用 ThuThesis 的研究生论文排版方案。
%
% 中文正文采用宋体小四号字，固定行距为 20 bp，
% 段落首行缩进两个汉字符。
%
% 章标题采用黑体三号字，居中排列。
% 一级节标题采用黑体 14 bp，二级节标题采用黑体 13 bp，
% 三级节标题采用黑体 12 bp，均左对齐。
%
% 各级标题使用自动编号，支持编号至三级节标题。
% 
% 
% \subsection{页眉页脚}
%
% GZUThesis 采用双面排版，奇偶页使用不同的页眉。
%
% 奇数页页眉居中显示当前章编号及标题，
% 偶数页页眉根据学位类型显示
% “贵州大学硕士学位论文”或“贵州大学博士学位论文”。
%
% 页眉采用宋体五号字，下方设置 0.75 bp 的横线。
% 页脚居中显示页码，采用五号西文字体。
%
% 页眉距纸张上边缘 2.2 cm，
% 页脚距纸张下边缘 1.75 cm。
% 
% 
% \subsection{论文结构}
%
% GZUThesis 将论文划分为前置部分、正文部分和后置部分。
%
% \begin{verbatim}
% \begin{document}
%
% \frontmatter
% \chapter{摘要}
% \tableofcontents
%
% \mainmatter
% \chapter{绪论}
%
% \backmatter
% \chapter{参考文献}
% \chapter{致谢}
%
% \end{document}
% \end{verbatim}
%
% 前置部分采用大写罗马数字页码，
% 正文部分采用阿拉伯数字页码并重新从 1 开始，
% 后置部分延续正文页码。
% 
% 
% 
% 
% 
% \subsection{目录}
%
% 使用 \cs{tableofcontents} 命令生成论文目录。
%
% GZUThesis 默认显示章、节和小节三级目录，
% 目录条目采用小四号字，固定行距 20 bp。
%
% 章目录采用黑体，节和小节目录采用宋体，
% 分别缩进一个和两个汉字符。
%
% 目录条目与页码之间使用点线连接，
% 页码右对齐。
%
% 目录应至少编译两次，以正确更新目录内容及页码。
% 
% \subsection{数学字体、数学符号和公式编号}
%
% GZUThesis 使用 |amsmath| 与 |unicode-math|。
% 默认正文使用 Times New Roman，数学符号使用与其风格协调、支持完整数学字符的
% XITS Math；并不是把每个运算符强制用 Times New Roman 绘制。
% 字母的正斜体属于数学风格约定：如 \verb|$R$| 表示变量，
% \verb|$\mathrm{R}$| 表示正体字母，
% \verb|$\mathbb{R}$| 表示实数集合。后者使用数学字体中的衬线双线体。
%
% |math-style| 支持 |GB|（默认，适用于中文学位论文）、|ISO| 和 |TeX|。
% 以下七项可独立覆盖风格预设，默认 |auto| 表示遵循所选风格：
% \begin{description}
%   \item[uppercase-greek] 大写希腊字母：|italic|、|upright|。
%   \item[less-than-or-equal] 小于等于号：|slanted|、|horizontal|。
%   \item[integral] 积分号：|upright|、|slanted|。
%   \item[integral-limits] 积分上下限位置：|true|、|false|。
%   \item[partial] 偏微分符号：|upright|、|italic|。
%   \item[math-ellipsis] 数学省略号：|centered|、|lower|、|AMS|。
%   \item[real-part] 实部/虚部符号：|roman|、|fraktur|。
% \end{description}
%
% 全部数学选项可在文档类选项或导言区的 \cs{gzusetup} 中使用，
% 只在正文开始前完成字体与符号的统一初始化；不允许在正文内重新加载数学字体。
% 例如：
% \begin{verbatim}
% \gzusetup{
%   math-style = GB,
%   integral = upright,
%   partial = upright,
%   math-ellipsis = centered,
% }
% \end{verbatim}
%
% 公式编号默认按章编排，如（1.1），使用中文全角括号。
% 可通过 |eqn-paren-style=half| 使用半角括号；图表及公式的编号连接符
% 可通过 |number-separator| 统一设置，也可以分别设置。
% 交叉引用采用 \cs{label} 与 \cs{eqref}。
%
% \subsection{定理与证明环境}
%
% GZUThesis 使用 |amsthm| 宏包提供数学环境，
% 包括定理、定义、引理、命题、公理、推论等。
%
% 定理环境按照章节编号，
% 标题使用黑体，正文使用正常字体。
%
% 例如：
%
% \begin{verbatim}
% \begin{theorem}
%   对任意实数 $x$，均有 $x^2 \geq 0$。
% \end{theorem}
%
% \begin{proof}
%   根据实数的性质，命题成立。
% \end{proof}
% \end{verbatim}
%
% 使用 \cs{label} 和 \cs{ref}
% 可以实现定理、定义等环境的交叉引用。
%
% 证明结束时自动显示证明结束符号。
% 
% 
% \subsection{参考文献和附录独立文献表}
%
% GZUThesis 保留已有参考文献版式：参考文献正文字体、字号、行距、
% 条目间距及作者列表要求均可通过 \cs{gzusetup} 配置，
% 默认优先采用 GB/T 7714---2025 顺序编码制。
% 支持 BibTeX + natbib（含正文上标与行内引用）和 BibLaTeX + Biber。
% 两套后端不能在同一文档中同时加载。
%
% 对于 BibTeX + natbib，示例：
% \begin{verbatim}
% \usepackage[numbers,sort&compress]{natbib}
% \usepackage{hyperref}
% ...
% \bibliographystyle{gbt7714-2025-numeric}
% \bibliography{references}
% \appendix
% \chapter{补充实验}
% \begin{gzuappendixrefs}
%   附录中引用文献 \citep{example}。
%   \gzuprintappendixbibliography{references}
% \end{gzuappendixrefs}
% \end{verbatim}
%
% 对于 BibLaTeX + Biber，先在导言区设置 \cs{addbibresource}，
% 正文使用 \cs{printbibliography}，附录使用同样的
% |gzuappendixrefs| 环境和 \cs{gzuprintappendixbibliography} 命令。
%
% 附录文献表在默认设置下采用 A.1、A.2 等编号。
% |bib-appendix-prefix=false| 可以关闭该前缀。
% \textbf{重要：} BibTeX + natbib 中，模板为每个附录 bibunit 隔离文献键数据和
% PDF 超链接锚点，因此附录与正文使用同一个 BibTeX 键时，
% 点击附录引用只会跳向该附录的文献条目，不再跳向正文同名条目。
% 每个附录 bibunit 产生独立的辅助文件，编译时也必须运行对应的 BibTeX。
%
% \subsection{生成封面}
%
% GZUThesis 使用 \cs{maketitle} 自动生成学位论文封面。
% 封面信息通过 \cs{gzusetup} 命令设置。
%
% \begin{verbatim}
% \gzusetup{
%   graduation-year = {2027},
%   title = {中文论文题目},
%   title* = {English Thesis Title},
%   author = {张三},
%   date = {2026-10-01},
% }
%
% \begin{document}
% \maketitle
% \frontmatter
% ...
% \end{document}
% \end{verbatim}
%
% 模板根据 |degree| 和 |degree-type| 自动确定
% 学位层次及封面中的学位类别标识。
% 
% 

% \subsection{致谢}
%
% GZUThesis 提供 |acknowledgements| 环境。
% 致谢不参与章节编号，但自动加入目录。
%
% \begin{verbatim}
% \begin{acknowledgements}
% 感谢导师和同学的帮助。
% \end{acknowledgements}
% \end{verbatim}
%
% \subsection{附录}
%
% 使用 \cs{appendix} 命令开启附录。
% 附录按照 A、B、C 等大写英文字母编号。
%
% \begin{verbatim}
% \appendix
%
% \chapter{补充实验数据}
%
% \chapter{补充数学证明}
% \end{verbatim}
%
% 附录的图、表和公式按照附录编号独立编号，
% 例如 A.1、A.2、B.1 等。
%
% 目录默认只显示附录章标题。
% 

% \subsection{图表编号、双语题注与三线表}
%
% 图、表和公式默认按章编号，采用句点连接。
% 附录相应为 A.1 等；以下示例可改用短横线，章节和定理编号不变。
% 可以在导言区统一覆盖默认值：
%
% \begin{verbatim}
% \gzusetup{
%   number-separator = {-},
%   table-rule-width = {1.5bp},
%   table-midrule-width = {0.75bp},
%   table-cmidrule-width = {0.75bp},
%   caption-language = auto,
% }
% \end{verbatim}
%
% |number-separator| 一次性控制图、表和公式编号连接符；
% 仍可通过 |figure-number-separator|、|table-number-separator|、
% |equation-number-separator| 分别覆盖。按配置出现顺序，后赋值者优先。
% 不修改章节或定理编号。
% |table-rule-width| 控制 \cs{toprule} 和 \cs{bottomrule}；
% 另外两项分别控制 \cs{midrule} 和 \cs{cmidrule}。
% 不改变普通 \cs{hline}，命令上的显式线宽参数仍有优先级。
%
% 题注语言支持三种模式：
% \begin{description}
%   \item[auto] 默认值；硕士只显示中文，博士显示中英文。
%   \item[chinese] 只显示中文，忽略已填写的英文题目。
%   \item[bilingual] 显示中文和英文，适用于任意学位层次。
% \end{description}
%
% \cs{gzucaption} 接收中文和英文题目两个必选参数。
% 双语模式下英文不能为空；模板不自动翻译。
% 中文模式下可将英文参数留空，也可保留英文以便后续切换。
%
% \begin{verbatim}
% \gzucaption{无人机飞行状态}{UAV flight states}
% \label{fig:flight}
%
% % Chinese-only mode
% \gzucaption{无人机飞行状态}{}
%
% % Optional short Chinese entry in the list
% \gzucaption[飞行状态]{无人机飞行状态变化曲线}
%   {Changes in UAV flight states}
% \end{verbatim}
%
% 双语题注中文在上、英文在下，共享一个编号。
% 图表清单只收录中文条目；标签放在题注命令之后。
% 此选项也控制原生 \cs{bicaption} 的语言显示，
% 但不把普通 \cs{caption} 自动转换成双语。
% 缺少英文的检查只对 \cs{gzucaption} 生效。
% 博士使用 |chinese| 仍可编译，但会收到警告。
%
% 跨页表格使用原生 \cs{bicaption}，题注行以 |\\| 结束。
% 其英文内容由作者自行检查。
%
% \begin{verbatim}
% \begin{longtable}{ll}
% \bicaption{实验数据}{Experimental data}
% \label{tab:data}\\
% \toprule
% Item & Value \\
% \midrule
% ...
% \bottomrule
% \end{longtable}
% \end{verbatim}
% 
% 
% \subsection{输出模式}
%
% GZUThesis 支持打印版和电子版两种输出模式。
%
% |output=print| 为默认模式，在双面排版时，
% 根据页面奇偶性自动补充必要的空白页。
%
% |output=electronic| 为电子版，不额外生成
% 打印装订所需的空白页。
%
% |include-spine| 仅对打印版生效。
% 当电子版设置 |include-spine=true| 时，
% 模板忽略该选项并给出警告。
% 
% 
% 
% 
% \StopEventually{}
%
% \section{实现细节}
%
% 以下代码用于生成 |gzuthesis.cls|。
%
% \subsection{基本信息}
% 声明文档类的名称和版本。
%
%    \begin{macrocode}
%<*cls>
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{gzuthesis}[2026/11/17 v0.3.1-dev Guizhou University Thesis Template]
%    \end{macrocode}
%
% \subsection{统一配置系统}
% \label{sec:defoption}
%
% 配置声明参考 ThuThesis 的 |name|、|choices|、|default| 和选项钩子机制。
% 文档类选项与 \cs{gzusetup} 共用 |gzu| 配置族；数据保存与页面排版分离。
% 本实现增加赋值前校验和类选项锁定，避免非法输入或延迟修改破坏已有状态。
%
% \subsubsection{配置接口与辅助命令}
%
% \cs{gzusetup} 可以多次调用，同一作用域内后一次设置覆盖前一次设置。
% 文本字段原样保存，不提前展开题目中的命令；枚举字段展开后检查合法值。
% 配置项之间不应包含空白行。
%
%    \begin{macrocode}
\RequirePackage{kvdefinekeys}
\RequirePackage{kvsetkeys}
\RequirePackage{kvoptions}

\SetupKeyvalOptions{
  family  = gzu,
  prefix  = gzu@,
  setkeys = \kvsetkeys,
}

\newcommand\gzuthesis{GZUThesis}
\newcommand\gzuversion{0.3.1-dev}
% 保留已有示例中的版本命令；论文信息不依赖该别名。
\providecommand\version{\gzuversion}

\newcommand\gzu@error[2]{\ClassError{gzuthesis}{#1}{#2}}

% 各排版模块初始化完毕后，才执行用户赋值触发的钩子。
\newif\ifgzu@options@ready
\gzu@options@readyfalse
\let\gzu@setup@hook\@empty

\newcommand\gzusetup[1]{%
  \let\gzu@setup@hook\@empty
  \kvsetkeys{gzu}{#1}%
  \gzu@setup@hook
}

\newcommand\gzu@define@key[1]{%
  \kvsetkeys{gzu@key}{#1}%
}

\newcommand\gzu@option@hook[2]{%
  \expandafter\g@addto@macro\csname gzu@#1@@code\endcsname{#2}%
}

\newcommand\gzu@run@option@hook[1]{%
  \ifgzu@options@ready
    \@nameuse{gzu@#1@@code}%
  \fi
}
%    \end{macrocode}
%
% \subsubsection{配置声明}
%
% |name| 指定内部变量名，|choices| 指定合法枚举值，
% |default| 指定初始值；省略默认值时，文本字段为空，枚举字段取首项。
% |code| 可定义赋值后的操作，后续模块也可通过 \cs{gzu@option@hook} 追加操作。
% 文档类初始化期间，定义默认值和解析类选项只更新数据与枚举条件；
% 各排版模块加载所需宏包后自行应用一次初始值。
%
%    \begin{macrocode}
\kv@define@key{gzu@definition}{name}{\def\gzu@@name{#1}}
\kv@define@key{gzu@definition}{choices}{\def\gzu@@choices{#1}}
\kv@define@key{gzu@definition}{default}{\def\gzu@@default{#1}}
\kv@define@key{gzu@definition}{code}{\def\gzu@@code{#1}}

\kv@set@family@handler{gzu@key}{%
  \@ifundefined{gzu@#1@@name}{%
    \gzu@declare@key{#1}{#2}%
  }{%
    \gzu@error{Option `#1' already defined}%
      {Declare each option only once.}%
  }%
}

\newcommand\gzu@declare@key[2]{%
  \def\gzu@@name{#1}%
  \let\gzu@@choices\@empty
  \let\gzu@@default\@empty
  \let\gzu@@code\@empty
  \kvsetkeys{gzu@definition}{#2}%
  \expandafter\let\csname gzu@#1@@name\endcsname\gzu@@name
  \expandafter\let\csname gzu@#1@@choices\endcsname\gzu@@choices
  \expandafter\let\csname gzu@#1@@code\endcsname\gzu@@code
  \@namedef{gzu@#1@@reset}{}%
  \@namedef{gzu@#1@@guard}{\@firstofone}%
  \def\gzu@declare@choice##1{%
    \ifx\gzu@@default\@empty
      \def\gzu@@default{##1}%
    \fi
    \expandafter\newif\csname ifgzu@\gzu@@name @##1\endcsname
    \@namedef{gzu@#1@@choice@##1}{}%
    \expandafter\g@addto@macro\csname gzu@#1@@reset\endcsname{%
      \@nameuse{gzu@\@nameuse{gzu@#1@@name}@##1false}%
    }%
  }%
  \expandafter\comma@parse\expandafter{\gzu@@choices}{\gzu@declare@choice}%
  \kv@define@key{gzu}{#1}{\gzu@set@key{#1}{##1}}%
  \def\gzu@set@default##1{\gzu@set@key{#1}{##1}}%
  \expandafter\gzu@set@default\expandafter{\gzu@@default}%
}
%    \end{macrocode}
%
% \subsubsection{赋值、校验与生效阶段}
%
% 先检查配置项是否允许修改，再检查枚举值；通过后才保存数据并更新条件。
% 非法值不会清空旧状态，也不会触发排版钩子。
% 类初始化选项在文档类加载结束时锁定，不能通过 \cs{gzusetup} 再次设置。
%
%    \begin{macrocode}
\newcommand\gzu@set@key[2]{%
  \@nameuse{gzu@#1@@guard}{\gzu@set@key@value{#1}{#2}}%
}

\newcommand\gzu@set@key@value[2]{%
  \expandafter\ifx\csname gzu@#1@@choices\endcsname\@empty
    \@namedef{gzu@\@nameuse{gzu@#1@@name}}{#2}%
    \gzu@run@option@hook{#1}%
  \else
    \edef\gzu@@value{#2}%
    \@ifundefined{gzu@#1@@choice@\gzu@@value}{%
      \gzu@error{Invalid value `#1 = \gzu@@value'}%
        {Allowed values: \@nameuse{gzu@#1@@choices}.}%
    }{%
      \expandafter\let\csname gzu@\@nameuse{gzu@#1@@name}\endcsname\gzu@@value
      \@nameuse{gzu@#1@@reset}%
      \@nameuse{gzu@\@nameuse{gzu@#1@@name}@\gzu@@value true}%
      \gzu@run@option@hook{#1}%
    }%
  \fi
}

\newcommand\gzu@option@classonly[1]{%
  \@namedef{gzu@#1@@guard}{\gzu@reject@class@option{#1}}%
}

\newcommand\gzu@reject@class@option[2]{%
  \gzu@error{Option `#1' is only valid in documentclass}%
    {Move this option to the optional argument of \string\documentclass.}%
}
%    \end{macrocode}
